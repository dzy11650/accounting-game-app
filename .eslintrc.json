{
  "extends": ["eslint:recommended", "plugin:react/recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "plugins": ["react"],
  "settings": {
    "react": { "version": "detect" }
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off"
  },
  "ignorePatterns": ["dist/", "node_modules/", "android/", "release/", "src-tauri/", "target-tauri/"]
}
